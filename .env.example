# Copy to .env for Docker Compose. On a cloud host, set these in its environment UI.
# Required: use a unique password, 16+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=production
TRUST_PROXY_HOPS=1

# Docker Compose injects DATABASE_URL from POSTGRES_PASSWORD below.
# For a native run or cloud host, provide a PostgreSQL URL with pgvector support.
DATABASE_URL=postgresql://sabeel:change-this-database-password@localhost:5432/sabeel
POSTGRES_PASSWORD=change-this-database-password
DATABASE_SSL=false
DATABASE_SSL_VERIFY=true
DB_POOL_SIZE=8
WORKER_CONCURRENCY=2
DEFAULT_TIMEZONE=Asia/Kolkata

# Choose openai OR gemini. Keep embedding provider/model unchanged after indexing.
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Leave model overrides blank to use the defaults in backend/ai.ts.
CHAT_MODEL=
EMBEDDING_MODEL=
# OpenAI default: gpt-4.1-mini / text-embedding-3-small, dimensions 1536.
# Gemini default: gemini-2.5-flash / gemini-embedding-001, dimensions 1536.
# Voice transcription uses OpenAI even when chat uses Gemini.
TRANSCRIPTION_MODEL=whisper-1
OPENAI_BASE_URL=https://api.openai.com/v1

# pgvector works without a Pinecone account. Optional external Pinecone mirror/search:
VECTOR_BACKEND=pgvector
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_NAMESPACE=sabeel

# Drive option A: personal Google Drive via OAuth refresh token.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Drive option B: service-account JSON (one line), preferably a Workspace Shared Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_AUTO_SYNC=false

# Meta WhatsApp Cloud API (digits only, no +). Use your production System User token.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_DEFAULT_RECIPIENT=
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Live internet research.
TAVILY_API_KEY=

# Exact HTTPS hostnames allowed for court feeds and connected HTTP tools; comma separated.
ALLOWED_FETCH_HOSTS=
# Optional auto-monitor source mappings; see DEPLOYMENT.md. Do not guess a court URL.
MONITOR_SOURCES_JSON=[]
# Explicit /tool integrations. Tokens stay in separate environment variables.
CONNECTED_TOOLS_JSON=[]
# Add staff using bcrypt hashes, not plaintext passwords. See npm run hash-password.
STAFF_USERS_JSON=[]

# Tesseract languages available in Docker: eng, hin, urd, tel.
OCR_ENABLED=true
OCR_LANGUAGES=eng
