{
  "name": "sabeel-legal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx backend/server.ts",
    "build": "vite build",
    "start": "tsx backend/server.ts",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration.ts",
    "hash-password": "node scripts/hash-password.mjs",
    "check": "npm run lint && npm test && npm run build",
    "format": "prettier --write backend src tests scripts *.json *.ts *.yaml .github/workflows/*.yml",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.1",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.16.0",
    "@types/pdfkit": "^0.17.2",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
