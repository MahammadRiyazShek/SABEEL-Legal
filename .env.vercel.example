# Set in Vercel Project Settings > Environment Variables; then redeploy.
# SABEEL 2.0 — no login / signup. Set these in Vercel and on the worker.
APP_URL=https://sabeel-legal.vercel.app
NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1

# REQUIRED: the SAME persistent PostgreSQL + pgvector database on both hosts.
DATABASE_URL=
# Your provider URL may already contain sslmode=require. Set according to provider.
DATABASE_SSL=true
DATABASE_SSL_VERIFY=true
DB_POOL_SIZE=3
WORKER_CONCURRENCY=2
DEFAULT_TIMEZONE=Asia/Kolkata
# Vercel's daily scheduler uses this secret; the worker also schedules every 30s.
CRON_SECRET=

# REQUIRED for indexing and AI research: choose openai OR gemini.
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
CHAT_MODEL=
EMBEDDING_MODEL=
# Defaults: OpenAI gpt-4.1-mini / text-embedding-3-small, 1536 dimensions.
# Gemini gemini-2.5-flash / gemini-embedding-001, 1536 dimensions.
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
# Voice transcription uses an OpenAI key, even with Gemini chat.

# Optional Pinecone mirror; canonical text and metadata remain in PostgreSQL.
VECTOR_BACKEND=pgvector
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_NAMESPACE=sabeel

# Google Drive: OAuth refresh token for personal Drive, OR service account.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_AUTO_SYNC=false

# Meta WhatsApp Cloud API, required only for the WhatsApp interface.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Digits only, country code included; comma separated.
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_DEFAULT_RECIPIENT=
# Approved one-body-parameter template for alerts outside the reply window.
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Internet research and registered external actions.
TAVILY_API_KEY=
# Exact allowed HTTPS hostnames for court feeds / connected tools.
ALLOWED_FETCH_HOSTS=
MONITOR_SOURCES_JSON=[]
CONNECTED_TOOLS_JSON=[]

# Worker-only extraction configuration; Docker includes all four language packs.
OCR_ENABLED=true
OCR_LANGUAGES=eng
# Docker Compose local database password only:
POSTGRES_PASSWORD=
